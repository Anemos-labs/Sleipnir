{
  // the sample user's ~/.sleipnir/config.json: the manager runs on the default, every worker role on heimdall/demo-model
  "models": {
    "default": "anthropic/claude-sonnet-5-5",
    "roles": {
      "backend": "heimdall/demo-model",
      "frontend": "heimdall/demo-model",
      "fullstack": "heimdall/demo-model",
      "tester": "heimdall/demo-model",
      "reviewer": "heimdall/demo-model",
      "scout": "heimdall/demo-model",
      "docs": "heimdall/demo-model"
    },
    "favorites": [
      "anthropic/claude-sonnet-5-5",
      "anthropic/claude-haiku-5-5",
      "heimdall/demo-model"
    ]
  },
  "permissions": {
    "mode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)"
    ]
  },
  "providers": {
    "local": {
      "base_url": "http://127.0.0.1:8000/v1",
      "options": { "capture_tokens": true }
    }
  },
  "cache": {
    "shared_ttl": "5m"
  },
  "swarm": {
    "max_workers": 16,
    "budget_usd": 25
  },
  "mcp": {
    "docs": { "command": "docs-mcp" },
    "sentry": { "command": "sentry-mcp", "args": ["--org", "shop"] },
    "postgres": { "command": "postgres-mcp", "disabled": true }
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "~/.sleipnir/hooks/block-dangerous.sh", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "~/.sleipnir/hooks/format.sh", "timeout": 10 } ] }
    ]
  }
}
