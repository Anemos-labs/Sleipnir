/internal/core/canon.go          @Thanos420NoScope
/internal/agent/prompt.go        @Thanos420NoScope
/internal/perm/                  @Thanos420NoScope
/internal/harden/                @Thanos420NoScope
/internal/provider/endpoint.go   @Thanos420NoScope
/internal/config/trust.go        @Thanos420NoScope
/internal/events/log.go          @Thanos420NoScope
/internal/checkpoint/            @Thanos420NoScope
/internal/workspace/             @Thanos420NoScope
/internal/gitx/                  @Thanos420NoScope
/.github/                        @Thanos420NoScope
