{
  "model": "claude-opus-5-5",
  "max_tokens": 4096,
  "thinking": {
    "type": "adaptive",
    "block_binding": {
      "prefix_mismatch_behavior": "drop_block"
    }
  },
  "tools": [
    {
      "name": "bash",
      "description": "Run a shell command.",
      "input_schema": {
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      }
    },
    {
      "name": "read",
      "description": "Read a file.",
      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "strict": true
    }
  ],
  "system": [
    {
      "type": "text",
      "text": "You are Sleipnir.",
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Run the tests."
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "thinking",
          "thinking": "weigh <a> & <b>\u2028 then decide",
          "signature": "sig-fixture-1"
        },
        {
          "type": "tool_use",
          "id": "toolu_01",
          "name": "bash",
          "input": {
            "command": "go test"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_01",
          "content": [
            {
              "type": "text",
              "text": "ok"
            }
          ]
        }
      ]
    },
    {
      "role": "system",
      "content": [
        {
          "type": "text",
          "text": "board: 3 tasks open"
        }
      ],
      "clear_at": "next_user_message"
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "thinking",
          "thinking": "weigh <a> & <b>\u2028 then decide",
          "signature": "sig-fixture-2"
        },
        {
          "type": "tool_use",
          "id": "toolu_02",
          "name": "bash",
          "input": {
            "command": "go vet"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_02",
          "content": [
            {
              "type": "text",
              "text": "clean"
            }
          ],
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    },
    {
      "role": "system",
      "content": [
        {
          "type": "text",
          "text": "board: 2 tasks open"
        }
      ],
      "clear_at": "next_user_message"
    }
  ]
}
