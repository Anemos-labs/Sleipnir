{
  "model": "claude-opus-5-5",
  "max_tokens": 4096,
  "tools": [
    {
      "name": "bash",
      "description": "Run a shell command.",
      "input_schema": {
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      }
    },
    {
      "name": "read",
      "description": "Read a file.",
      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "strict": true,
      "cache_control": {
        "type": "ephemeral",
        "ttl": "1h"
      }
    }
  ],
  "system": [
    {
      "type": "text",
      "text": "You are Sleipnir, a careful coding agent.",
      "cache_control": {
        "type": "ephemeral",
        "ttl": "1h"
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "<shared-context>the project is a Go module</shared-context>"
        },
        {
          "type": "text",
          "text": "<role-context>backend conventions</role-context>",
          "cache_control": {
            "type": "ephemeral"
          }
        },
        {
          "type": "text",
          "text": "<my-notes>none yet</my-notes>"
        },
        {
          "type": "text",
          "text": "Fix the failing test.",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    }
  ]
}
